# Production Environment Variables for Backend
# This file should be used on Render or other production environments

# ======================================
# SERVER CONFIGURATION
# ======================================
HOST=0.0.0.0
PORT=8000
DEBUG=False

# ======================================
# DATABASE CONFIGURATION
# ======================================
# Use MongoDB Atlas for production
MONGODB_URL=${MONGODB_URL}
DATABASE_NAME=pitch_insight_prod

# ======================================
# SECURITY & AUTHENTICATION
# ======================================
SECRET_KEY=${SECRET_KEY}
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ======================================
# CORS CONFIGURATION
# ======================================
# Add your Vercel frontend URL here
ALLOWED_ORIGINS=https://pitch-insight-frontend.vercel.app

# ======================================
# EXTERNAL API KEYS
# ======================================
WEATHER_API_KEY=${WEATHER_API_KEY}
GEMINI_API_KEY=${GEMINI_API_KEY}

# ======================================
# PAYMENT GATEWAY (RAZORPAY)
# ======================================
RAZORPAY_KEY_ID=${RAZORPAY_KEY_ID}
RAZORPAY_KEY_SECRET=${RAZORPAY_KEY_SECRET}

# ======================================
# FILE UPLOAD CONFIGURATION
# ======================================
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/jpg

# ======================================
# SUBSCRIPTION PLANS
# ======================================
PRO_MONTHLY_PRICE=499
PRO_YEARLY_PRICE=4999
CURRENCY=INR
