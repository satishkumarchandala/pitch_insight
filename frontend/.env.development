# Frontend Environment Variables - Development
# This file is for local development
# Create .env.local for local overrides (this file is gitignored)

# Backend API URL - Development
VITE_API_URL=http://localhost:8000

# App Configuration
VITE_APP_NAME=Pitch Insight
VITE_APP_VERSION=2.0.0

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=true

# Razorpay (Test Keys for Development)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_here
